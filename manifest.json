{
  "manifest_version": 3,
  "name": "GUC CMS Downloader",
  "version": "3.3.1",
  "description": "Downloads files from GUC CMS with organized naming, course folders, checkboxes, and bulk tools.",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://cms.guc.edu.eg/*"
  ],
  "background": {
    "service_worker": "background_script.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cms.guc.edu.eg/apps/student/CourseViewStn*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "guc-cms-downloader@Sirye8.github.io",
      "strict_min_version": "109.0",
      "update_url": "https://sirye8.github.io/guc-cms-downloader/updates.json"
    }
  }
}
